+const OriginalDatabase = Database;
+function PatchedDatabase(...args) {
+  try {
+    return new OriginalDatabase(...args);
+  } catch (error) {
+    console.error('Failed to initialize SQLite database:', error);
+    // Return a mock database object
+    return {
+      prepare: () => ({ run: () => {}, get: () => undefined, all: () => [] }),
+      close: () => {}
+    };
+  }
+}
